---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import flowerSnoopy from '../../assets/IMG_7367-removebg-preview.png';
import graduateSnoopy from '../../assets/IMG_7368-removebg-preview.png';
import dinnerDogs from '../../assets/IMG_7370-removebg-preview.png';
import courseSnoopys from '../../assets/IMG_8862-removebg-preview.png';
import restingSnoopy from '../../assets/IMG_8864-removebg-preview.png';

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as typeof entry.data & { course?: string; type?: string };
const documentTypes: Record<string, string> = {
  synthese: 'Synthèse',
  exercices: 'Exercices',
  formulaire: 'Formulaire',
  examens: 'Examens',
};
const course = data.course;
const documentType = data.type ? documentTypes[data.type] : undefined;
const isDocument = Boolean(course && documentType && /\/(synthese|exercices|formulaire|examens)$/.test(entry.id));
const searchTitle = `${course} · ${documentType}`;
const isCoursePage = /^cours\/[^/]+(?:\/index)?$/.test(entry.id);
const pinkArtByType: Record<string, ImageMetadata> = {
  synthese: flowerSnoopy,
  exercices: dinnerDogs,
  formulaire: restingSnoopy,
  examens: graduateSnoopy,
};
const pinkArt = isCoursePage ? courseSnoopys : pinkArtByType[data.type || ''];
const pinkArtKind = isCoursePage ? 'course' : data.type;
---
<Default {...Astro.props} />
{pinkArt && <img
  class:list={['pink-title-sticker', pinkArtKind && `pink-title-sticker--${pinkArtKind}`]}
  src={pinkArt.src}
  width={pinkArt.width}
  height={pinkArt.height}
  alt=""
  loading="lazy"
  decoding="async"
/>}
{isDocument && <>
  <div
    class="document-context"
    data-pagefind-ignore
    data-pagefind-meta={`title:${searchTitle}`}
  >
    <span data-pagefind-meta="course" data-pagefind-filter="Cours">{course}</span>
    <span aria-hidden="true">·</span>
    <span data-pagefind-meta="documentType" data-pagefind-filter="Type">{documentType}</span>
  </div>
  <div class="document-actions">
    <button type="button" class="pdf-action" data-print hidden>Exporter en PDF</button>
    <span data-print-hint hidden>Choisir « Enregistrer au format PDF ».</span>
  </div>
</>}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  });
  document.querySelectorAll<HTMLElement>('[data-print-hint]').forEach((hint) => { hint.hidden = false; });
</script>
