---
const { entry } = Astro.locals.starlightRoute;
const data = entry.data as typeof entry.data & { type?: string };
const documentTypes = new Set(['synthese', 'exercices', 'formulaire', 'examens']);
const [root, courseSlug, documentType] = entry.id.toLowerCase().split('/');
const isAcademicDocument = Boolean(
  root === 'cours' &&
  courseSlug &&
  documentType &&
  documentTypes.has(documentType) &&
  data.type === documentType
);
const cmsSlug = isAcademicDocument ? `${courseSlug}-${documentType}` : undefined;
---

{isAcademicDocument && (
  <a
    class="edit-button"
    href={`https://app.pagescms.org/nxss-23/m-library/main/file/${cmsSlug}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Modifier"
    title="Modifier"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="M4 20h4l11-11-4-4L4 16v4Zm9.5-13.5 4 4" />
    </svg>
  </a>
)}

<style>
  .edit-button {
    position: fixed;
    z-index: calc(var(--sl-z-index-toc) - 1);
    inset-inline-end: calc(1rem + env(safe-area-inset-right, 0px));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 50%;
    background: var(--sl-color-bg-sidebar);
    box-shadow: 0 3px 12px #10274b1f;
    color: var(--sl-color-text);
  }

  .edit-button:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }

  .edit-button:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }

  .edit-button svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  @media print {
    .edit-button {
      display: none;
    }
  }
</style>
